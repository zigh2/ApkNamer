    <string name="tour_done">Done</string>
    <string name="tour_skip">Skip</string>
    <string name="tour_step">%1$d / %2$d</string>
    <string name="tour_1_title">Choose where to look</string>
    <string name="tour_1_body">Pick a folder, then tap Scan. APK Namer finds APK, XAPK, APKM and APKS files and reads the real app name and version.</string>
    <string name="tour_2_title">Filter the list</string>
    <string name="tour_2_body">By default you only see files that need a new name (red). Switch to Named (green) or All, or filter by format, updates or duplicates.</string>
    <string name="tour_3_title">Open and select</string>
    <string name="tour_3_body">Tap a row for details: size, path, permissions and duplicates. Tick the box to select it for renaming.</string>
    <string name="tour_4_title">Rename</string>
    <string name="tour_4_body">Press Rename to apply the new names. You can undo the last batch at any time.</string>
    <string name="tour_5_title">Duplicates</string>
    <string name="tour_5_body">Duplicates are byte-identical files. Review them on their own page and delete the extra copies; one copy of each app is always kept.</string>
    <string name="tour_6_title">Make it yours</string>
    <string name="tour_6_body">In Settings you can build the file-name template by dragging tags, choose the theme and language, and replay this tour. You can keep using the app while this tip is open; drag the tip to move it.</string>
</resources>
